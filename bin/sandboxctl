#!/usr/bin/env bash
# sandboxctl — preflight session control.
# Usage: sandboxctl <status|diff|apply|discard> [task_id] [--yes]
# Run `sandboxctl --help` for the full usage and security notes.
#
# status   : lists the active sessions in plain language (readable id, real
#            workspace, number of commands run, whether there is something to
#            apply) plus the EXACT command to approve each one. The id to use is
#            the one in the left column.
# apply    : shows a human-readable summary FIRST (per file: edited with how many
#            lines, created, DELETED, permissions before -> after), then the
#            technical diff, and only then asks for confirmation. Then syncs the
#            sandbox copy INTO the real workspace (whole-workspace, no per-file
#            selection) and applies explicit deletions, NEVER a global --delete.
#            First validates the registered target (refuses home / Hermes config
#            and session trees / credential stores / system dirs / anything inside
#            the sandbox root), then verifies (fingerprint) that the real
#            workspace did not change since the clone (TOCTOU) and that the copy
#            contains no symlink escaping the sandbox root. Requires
#            confirmation: --yes is honored ONLY when stdin is a terminal.
#            The summary and the diff are the REVIEW view; apply never reads
#            them to decide what to copy (it syncs the copy).
# discard  : removes the copy. The real workspace is not touched, and the
#            registered target is never read: discard works on any session.
#            Requires the same interactive confirmation as apply.
# diff     : prints a session's PENDING.diff.
set -euo pipefail
shopt -s nullglob

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
sandboxctl — preflight session control.

Usage:
  sandboxctl status                     list sessions: readable id, workspace, commands, pending
  sandboxctl diff   <task_id>           print the session's PENDING.diff (technical diff)
  sandboxctl summary <task_id>          print only the human-readable review of a session
  sandboxctl apply  <task_id> [--yes]   show the review, then sync the copy into the real workspace
  sandboxctl discard <task_id> [--yes]  remove the copy (real workspace untouched)

Finding the id: run `sandboxctl status`. The left column is the task id to
pass here (the same one printed at the top of every review message).

Security notes (read carefully):
  * apply and discard require interactive confirmation. --yes is honored ONLY
    when stdin is a real terminal. This is a BEST-EFFORT guard: a determined
    agent that allocates a pty (python3 -c "import pty", script, ssh -tt ...)
    can self-approve. It stops accidental non-TTY approvals, not a determined
    local agent.
  * The sandbox root is derived from the Hermes home. With multiple profiles,
    export HERMES_HOME=<that profile's hermes home> so this command targets
    THAT profile's sessions, e.g.:
        export HERMES_HOME=~/.hermes/profiles/<profile>
    A per-profile plugin-config override ("sandbox_root") is NOT derived from
    the environment: the backend writes the effective root into a one-line
    marker at <derived root>/.preflight-root, and this CLI reads that marker.
    If the marker is missing, the CLI uses the derived root. The marker is a
    convenience, not a security boundary (the staging root is writable by the
    sandboxed agent).
  * PREFLIGHT_ROOT is not exported to sandboxed commands anymore, but that is
    not a hiding boundary: a child still derives the root from its cwd
    (<root>/<id>/workspace) or from its pinned $TMPDIR. The variable is
    accepted as transport for scripts/tests and MUST match the effective root
    (marker or derived); a mismatched value is refused.
  * apply is WHOLE-WORKSPACE: it syncs the whole copy (rsync -a, no global
    --delete) and applies explicit deletions. The review shows the FILE LIST
    (created / edited / DELETED / permissions before -> after, from the tree
    diff plus `rsync --dry-run`) before the technical diff; the technical diff
    is CONTENT only, so permissions and mtime-only changes appear in the
    review list, not as diff lines. Files under the pinned TMPDIR
    (.preflight-tmp) are never applied and never listed.
  * After a successful apply the session is left CLEAN: PENDING.diff is
    emptied and the fingerprint is refreshed, so reusing the same task_id
    legitimately starts a fresh review (the next create_environment re-clones
    from the applied state). A second apply without new changes will then
    report "no pending changes" instead of a stale CHANGED.
EOF
  exit 0
fi

# The sandbox root must match the backend's effective root (each profile gets
# its own namespace). The backend derives the default from the active Hermes
# home + /sandbox and MAY honor a per-profile plugin config key
# "sandbox_root"; when it does, it writes a one-line marker,
# .preflight-root, INSIDE the derived root. So: derive EXPECTED_ROOT, then
# read the marker if present; that is the effective root. PREFLIGHT_ROOT is
# accepted as transport for scripts/tests but is NEVER trusted on its own to
# decide WHERE a destructive command runs: it must equal the effective root.
if [[ -n "${HERMES_HOME:-}" ]]; then
  EXPECTED_ROOT="${HERMES_HOME%/}/sandbox"
else
  EXPECTED_ROOT="${HOME:-}/.hermes/sandbox"
fi
EXPECTED_ROOT="$(realpath -m "$EXPECTED_ROOT" 2>/dev/null || echo "$EXPECTED_ROOT")"

EFFECTIVE_ROOT="$EXPECTED_ROOT"
if [[ -f "$EXPECTED_ROOT/.preflight-root" ]]; then
  marker="$(cat "$EXPECTED_ROOT/.preflight-root" 2>/dev/null | tr -d '[:space:]')"
  if [[ -n "$marker" ]]; then
    EFFECTIVE_ROOT="$(realpath -m "$marker" 2>/dev/null || echo "$marker")"
  fi
fi

if [[ -n "${PREFLIGHT_ROOT:-}" ]]; then
  ROOT="$PREFLIGHT_ROOT"
else
  ROOT="$EFFECTIVE_ROOT"
fi
ROOT="$(realpath -m "$ROOT" 2>/dev/null || echo "$ROOT")"
if [[ "$ROOT" != "$EFFECTIVE_ROOT" ]]; then
  echo "✖ refusing PREFLIGHT_ROOT=$PREFLIGHT_ROOT: it is not this profile's sandbox root (effective root: $EFFECTIVE_ROOT)." >&2
  echo "  Export HERMES_HOME=<profile hermes home> (see: sandboxctl --help) so the command targets YOUR sessions." >&2
  exit 1
fi

cmd="${1:-status}"
task_id="${2:-}"

# Human-readable review of a session (F1/R1, F1/H4, F1/H5). ONE implementation
# for every caller, so the message a human reads on `apply` is exactly the one
# `summary`/`status` print. Two REAL sources, the same the apply uses:
#   * a tree diff (git diff --no-index when the workspace is a repo, diff -ruN
#     otherwise) -> created / edited (+ how many changed lines);
#   * `rsync -ani --delete` (dry run, same excludes as apply) -> "*deleting"
#     (authoritative, works WITHOUT git) and the mode flag ("p") for
#     permissions, which the content diff does not show.
# It never reads PENDING.diff, so it cannot inherit the self-diff and cannot
# disagree with what apply would do. Apply never reads this output to decide.
print_review() {  # usage: print_review <orig> <copy>
  python3 - "$1" "$2" "$3" "$4" <<'PYEOF' || echo "  (no se pudo calcular el resumen; usa el diff técnico de abajo)"
import os, re, subprocess, sys

orig, copy, label = sys.argv[1], sys.argv[2], sys.argv[3]
MAX = 20
EXCL = ["--exclude=PENDING.diff", "--exclude=.preflight-tmp"]

def sh(argv):
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=120,
                           stdin=subprocess.DEVNULL)
        return (p.stdout or "") + (p.stderr or "")
    except Exception:
        return ""

if os.path.isdir(os.path.join(orig, ".git")):
    body = sh(["git", "diff", "--no-index", "--no-color", "--", orig, copy])
else:
    body = sh(["diff", "-ruN", "-x", "PENDING.diff", orig, copy])

def rel_of(raw):
    raw = raw.strip().strip('"')
    if raw in ("/dev/null", ""):
        return ""
    for base in (copy, orig):
        for pref in ("a" + base, "b" + base, base):
            if raw.startswith(pref):
                return raw[len(pref):].lstrip("/")
    return raw.lstrip("/")

stats, current = {}, None
for line in body.splitlines():
    if line.startswith(("diff --git ", "diff -ruN ", "diff -u ")):
        parts = line.split()
        current = rel_of(parts[-1]) if parts else ""
        if current in ("", "pENDING.diff") or current.endswith("PENDING.diff") \
           or ".preflight-tmp" in current:
            current = None
            continue
        stats.setdefault(current, 0)
        continue
    if line.startswith("+++ "):
        parts = line.split("\t")[0].split()
        rel = rel_of(parts[1]) if len(parts) > 1 else ""
        if rel:
            current = rel
            stats.setdefault(current, 0)
        continue
    if line.startswith("--- "):
        parts = line.split("\t")[0].split()
        rel = rel_of(parts[1]) if len(parts) > 1 else ""
        if rel and current is None:
            current = rel
            stats.setdefault(current, 0)
        continue
    if line.startswith(("@@", "Only in ", "Index ", "\\ No newline")):
        continue
    if current and line[:1] in ("+", "-") and not line.startswith(("+++", "---")):
        stats[current] = stats.get(current, 0) + 1
stats.pop("PENDING.diff", None)
# the pinned TMPDIR is never part of the review (apply excludes it too)
for _k in [k for k in stats if k.startswith(".preflight-tmp")]:
    stats.pop(_k, None)

meta = []
for raw in sh(["rsync", "-ani", "--delete", *EXCL, copy + "/", orig + "/"]).splitlines():
    line = raw.rstrip()
    if not line or line.startswith(("sending ", "sent ")):
        continue
    if line.startswith("*deleting "):
        meta.append((line[len("*deleting "):].lstrip(), "*deleting"))
    elif len(line) > 12 and line[11:12] == " ":
        rel = line[12:]
        if rel in (".", "./") or rel.endswith("/"):
            continue
        meta.append((rel, line[:11]))

deleted, perms, only_meta = {}, {}, {}
for rel, code in meta:
    rel = rel[2:] if rel.startswith("./") else rel
    if rel.startswith(".preflight-tmp"):
        continue  # pinned TMPDIR: never applied, never listed
    if code == "*deleting":
        deleted[rel.rstrip("/")] = None
    elif "p" in code:
        perms[rel] = code
    elif rel not in stats and rel not in deleted:
        only_meta[rel] = code
for rel in stats:
    if not os.path.lexists(os.path.join(copy, rel)):
        deleted[rel] = None
for rel in list(only_meta):
    if not os.path.lexists(os.path.join(copy, rel)):
        deleted[rel] = None
        only_meta.pop(rel, None)
# one row per real path: collapse a deletion reported under a longer prefix
for rel in sorted(list(deleted), key=lambda r: (r.count("/"), r)):
    for other in deleted:
        if other != rel and other.endswith("/" + rel):
            deleted.pop(rel, None)
            break

def mode(base, rel):
    try:
        return oct(os.lstat(os.path.join(base, rel)).st_mode & 0o777)[2:]
    except OSError:
        return None

rows = []
for rel in sorted(stats):
    if rel in deleted:
        continue
    if not os.path.lexists(os.path.join(orig, rel)):
        rows.append(("➕", rel, "nuevo"))
        continue
    n = stats.get(rel, 0)
    rows.append(("✏️", rel, "%d líneas cambiadas" % n if n else "cambiado"))
for rel in only_meta:
    if rel not in deleted and rel not in stats:
        rows.append(("✏️", rel, "cambiado (tamaño/fecha)"))
for rel in perms:
    before, after = mode(orig, rel), mode(copy, rel)
    rows.append(("🔒", rel, "permisos %s → %s" % (before, after) if before and after and before != after
                 else "permisos (cambiados)"))
for rel in deleted:
    rows.append(("❌", rel, "BORRADO"))
order = {"✏️": 0, "➕": 1, "🔒": 2, "❌": 3}
rows.sort(key=lambda r: (order.get(r[0], 9), r[1]))

n_new = sum(1 for r in rows if r[0] == "➕")
n_edit = sum(1 for r in rows if r[0] == "✏️")
n_del = sum(1 for r in rows if r[0] == "❌")
n_perm = sum(1 for r in rows if r[0] == "🔒")
n_files = len({r[1] for r in rows})  # a file can be both edited and re-permissioned
width = max([len(r[1]) for r in rows] + [8])
print("📋 Cambios pendientes en '%s'  (%d archivos: +%d ~%d -%d%s)" % (
    label, n_files, n_new, n_edit, n_del, " 🔒%d" % n_perm if n_perm else ""))
if not rows:
    print("   (sin cambios respecto al workspace real)")
for icon, rel, detail in rows[:MAX]:
    print("   %s %-*s  %s" % (icon, width, rel, detail))
if len(rows) > MAX:
    print("   … y %d archivos más (ver el diff completo para la lista entera)" % (len(rows) - MAX))
PYEOF
}

# --yes is honored ONLY on an interactive terminal. This is BEST-EFFORT: a
# determined agent can allocate a pty (script/pty module/ssh -tt) and
# self-approve; the gate stops accidental non-TTY approvals, not a determined
# local agent.
have_yes=0
for a in "$@"; do [[ "$a" == "--yes" || "$a" == "-y" ]] && have_yes=1; done
if [[ "$have_yes" -eq 1 && ! -t 0 ]]; then
  echo "✖ --yes is only honored on an interactive terminal (best-effort guard: a determined process can allocate a pty and self-approve). Run it yourself." >&2
  # F1/H9: never leave the human guessing which id to approve.
  if [[ -n "${2:-}" && "${2:-}" != --* ]]; then
    echo "  Run:" >&2
    echo "    sandboxctl $cmd $2" >&2
  else
    echo "  Run 'sandboxctl status' to get the id, then 'sandboxctl $cmd <task_id>'." >&2
  fi
  exit 2
fi

if [[ "$cmd" == "status" ]]; then
  echo "=== preflight: sesiones activas (raíz: $ROOT) ==="
  if [[ ! -d "$ROOT" ]]; then
    echo "  (no hay sesiones en $ROOT)"
    exit 0
  fi
  found=0
  for ws in "$ROOT"/*/workspace; do
    [[ -d "$ws" ]] || continue
    found=1
    id="$(basename "$(dirname "$ws")")"
    # Commands run in this session (one marker file per execute(); the diff
    # writer does not create markers). Session metadata, not the review.
    ncmds=0
    [[ -f "$ws/.preflight-tmp/.cmd-count" ]] && ncmds="$(cat "$ws/.preflight-tmp/.cmd-count" 2>/dev/null || echo 0)"
    pending=0
    if [[ -f "$ws/PENDING.diff" ]]; then
      # real diff lines (starting with + / - / diff / Only / Index)
      pending="$(grep -cE '^[+-]|^diff |^Only |^Index ' "$ws/PENDING.diff" || true)"
    fi
    orig="$(cat "$ROOT/$id/original" 2>/dev/null || echo '(registro ausente)')"
    echo
    echo "  id        : $id"
    echo "  workspace : $orig"
    echo "  comandos  : $ncmds ejecutados en la copia"
    if [[ "$pending" -gt 0 ]]; then
      echo "  estado    : ⚠ HAY CAMBIOS PENDIENTES (${pending} líneas de diff)"
      echo "  revisar   : sandboxctl summary $id"
      echo "  aprobar   : sandboxctl apply $id      # aplica TODO al workspace real"
      echo "  descartar : sandboxctl discard $id    # borra la copia, el real no se toca"
    else
      echo "  estado    : sin cambios pendientes (nada que aplicar)"
      echo "  descartar : sandboxctl discard $id"
    fi
  done
  if [[ "$found" -eq 0 ]]; then
    echo "  (no hay sesiones en $ROOT)"
  fi
  exit 0
fi

[[ -n "$task_id" ]] || { echo "usage: sandboxctl $cmd <task_id>"; exit 2; }
WS="$ROOT/$task_id/workspace"
ORIGIN_FILE="$ROOT/$task_id/original"

# The copy and the original registration must both be INSIDE the sandbox root.
# A relative/absolute path that resolves outside it (e.g. a crafted registration
# with ../ components) would let apply reach the real host — block it here.
_resolve_under_root() {
  # usage: _resolve_under_root <path> -> echoes the canonical path or exits.
  local p="$1"
  if [[ "$p" != /* ]]; then
    p="$ROOT/$p"
  fi
  # Reject any . or .. component (must stay strictly under ROOT).
  if [[ "$p" =~ (^|/)\.\.?(/|$) ]]; then
    echo "✖ refusing path with .. or . components: $p" >&2
    exit 1
  fi
  # Also reject symlinks: make sure the canonical real path stays under ROOT.
  local canon
  canon="$(realpath -m "$p" 2>/dev/null || echo "$p")"
  case "$canon" in
    "$ROOT"/*) echo "$canon" ;;
    *) echo "✖ refusing path outside the sandbox root: $canon" >&2; exit 1 ;;
  esac
}

# Task id that would escape the root (e.g. a crafted ../task_id) must fail.
case "$ROOT/$task_id" in
  *'/../'*|*'/./'*|*"../"*|*"./"*) echo "✖ refusing task id escaping the sandbox root: $task_id" >&2; exit 1 ;;
esac
WS="$(_resolve_under_root "$WS")" || exit 1
[[ -d "$WS" ]] || { echo "session not found: $task_id"; exit 1; }

# NOTE: everything below that reads $ORIG (the registration record) is apply-only
# and lives INSIDE the `apply)` case. `discard` never reads the record: its
# `rm -rf "$ROOT/$task_id"` is already confined to the validated root, so a
# session whose record was rewritten to a dangerous path must still be
# discardable (it is the only way out the plugin offers).

# Fingerprint of the real workspace at clone time (TOCTOU guard).
FP="$ROOT/$task_id/original.fingerprint"

# compute_fp <path>: sha256 fingerprint of a tree, same format as the backend's
# _write_original_fingerprint (path<TAB>mtime_ns<TAB>size<TAB>sha256<TAB>kind).
# Used before apply to detect real changes since the clone, and after a
# successful apply to refresh the reference so a reused task_id starts clean.
compute_fp() {
  python3 - "$1" <<'PYEOF'
import hashlib, os, sys
from pathlib import Path
root = Path(sys.argv[1])
lines = []
for _root, dirs, files in os.walk(root):
    dirs.sort(); files.sort()
    rel_root = os.path.relpath(_root, root)
    for d in dirs:
        p = os.path.join(_root, d)
        try:
            st = os.lstat(p)
        except OSError:
            continue
        lines.append(f"{os.path.join(rel_root, d)}\t{st.st_mtime_ns}\t{st.st_size}\t-\td")
    for f in files:
        p = os.path.join(_root, f)
        try:
            st = os.lstat(p)
        except OSError:
            continue
        if os.path.islink(p):
            try:
                h = hashlib.sha256(os.readlink(p).encode()).hexdigest()
            except OSError:
                h = "-"
        else:
            try:
                hs = hashlib.sha256()
                with open(p, "rb") as fh:
                    for chunk in iter(lambda: fh.read(65536), b""):
                        hs.update(chunk)
                h = hs.hexdigest()
            except OSError:
                h = "-"
        lines.append(f"{os.path.join(rel_root, f)}\t{st.st_mtime_ns}\t{st.st_size}\t{h}\tf")
print("\n".join(sorted(lines)))
PYEOF
}

case "$cmd" in
  diff)
    [[ -f "$WS/PENDING.diff" ]] && cat "$WS/PENDING.diff" || echo "(no PENDING.diff)"
    ;;

  summary)
    # The review ONLY (no apply, no confirmation): same block apply prints.
    if [[ -f "$ORIGIN_FILE" ]]; then
      print_review "$(cat "$ORIGIN_FILE")" "$WS" "$task_id" ""
    else
      echo "✖ missing original-workspace record for $task_id (cannot build the review)."
      exit 1
    fi
    ;;

  apply)
    # 0) Is this a legitimate apply target? The registration record is writable
    #    inside the staging root, so a crafted <id>/original could aim a
    #    whole-workspace rsync at the user's home, the Hermes home, a credential
    #    store or a system dir. Refuse BEFORE any rsync. Apply-only: `discard`
    #    never reads this record (see the note before the fingerprint block).
    [[ -f "$ORIGIN_FILE" ]] || { echo "missing original-workspace record for $task_id"; exit 1; }
    ORIG="$(cat "$ORIGIN_FILE")"
    [[ "$ORIG" = /* ]] || { echo "invalid original workspace: $ORIG"; exit 1; }
    [[ -d "$ORIG" ]] || { echo "invalid original workspace: $ORIG"; exit 1; }
    # Never apply back onto the copy itself, and never onto the sandbox staging dir.
    ORIG_REAL="$(realpath -m "$ORIG" 2>/dev/null || echo "$ORIG")"
    case "$ORIG_REAL" in
      "$ROOT"/*) echo "✖ refusing to apply onto a path inside the sandbox root: $ORIG" >&2; exit 1 ;;
    esac

    # Dangerous apply targets (same list as the backend's
    # _reject_forbidden_original, __init__.py). Refuse before ANY rsync.
    HOME_REAL="$(realpath -m "${HOME:-/nonexistent}" 2>/dev/null || echo "${HOME:-/nonexistent}")"
    if [[ -n "${HERMES_HOME:-}" ]]; then
      HERMES_HOME_REAL="$(realpath -m "$HERMES_HOME" 2>/dev/null || echo "${HERMES_HOME%/}")"
    else
      HERMES_HOME_REAL="$HOME_REAL/.hermes"
    fi

    # _is_under <path> <dir>: true when <path> equals <dir> or lives below it.
    _is_under() {
      local p="$1" d="$2"
      [[ "$d" == "/" ]] && return 0
      [[ "$p" == "$d" || "$p" == "$d"/* ]]
    }

    if [[ "$ORIG_REAL" == "$HOME_REAL" ]]; then
      echo "✖ refusing to apply onto your home directory: $ORIG_REAL" >&2
      echo "  A whole-workspace apply onto ~ would overwrite your personal files. Discard this session and start one in a project directory." >&2
      exit 1
    fi
    # F1/H10: a project under the Hermes home is a legitimate target
    # (~/.hermes/workspace/<proj>), but the Hermes CONFIG and LIVE SESSION trees
    # are never an apply target. Same names as the backend's
    # _HERMES_HOME_EXCLUDE: a path is refused when it IS or CONTAINS one of
    # these entries (config.yaml, profiles, sessions.db, plugins, sandbox...).
    HERMES_EXCLUDE=(
      config.yaml config profiles profiles.d profile.yaml auth.json auth.lock
      cookies tokens sessions sessions.db state.db state state-snapshots
      responses response_store.db recovered-state.db terminal-sessions
      checkpoints pending pending_messages processes.json runtime
      gateway_state.json gateway.sock gateway.lock gateway.pid kanban kanban.db
      lcm.db memory_store.db projects.db runs_idempotency.db safety
      plugins skills memories hooks hermes-agent bin scripts tools lsp pairing
      security shared shared-state.db sandbox sandboxes cache logs image_cache
      audio_cache plugin-data plugin-update-checks install_id installs
    )
    while IFS= read -r bad; do
      echo "✖ refusing to apply onto a Hermes config/session tree: $ORIG_REAL" >&2
      echo "  '$bad' is Hermes' own config, session or runtime state, not a project. Discard this session and start one in a project directory." >&2
      exit 1
    done < <(python3 - "$ORIG_REAL" "$HERMES_HOME_REAL" "${HERMES_EXCLUDE[@]}" <<'PYEOF'
import os, sys
orig, hh, names = sys.argv[1], sys.argv[2], set(sys.argv[3:])
o = os.path.realpath(orig)
h = os.path.realpath(hh)
if o == h or not (o == h or o.startswith(h.rstrip("/") + "/")):
    sys.exit(0)  # not under the Hermes home: nothing to check here
rel = os.path.relpath(o, h)
parts = rel.split(os.sep)
for i, part in enumerate(parts):
    if part in names:
        print(os.sep.join(parts[: i + 1]))
        break
PYEOF
)
    # A HOME directory is never an apply target. F1/H10 only made PROJECTS
    # inside a Hermes home legal (~/.hermes/workspace/<proj>); the home itself
    # still takes no whole-workspace sync. Detected structurally (a Hermes home
    # has config.yaml plus a shell rc, or sessions+cache) and by name, rather
    # than via one hard-coded path, because the suite and alternate profiles use
    # their own homes. $HOME itself is refused a few lines above.
    if [[ "$ORIG_REAL" != "$HOME_REAL" ]]; then
      if [[ -f "$ORIG_REAL/config.yaml" && -f "$ORIG_REAL/.bashrc" ]] \
         || [[ "$(basename "$ORIG_REAL")" =~ ^(sbx-)?home(-[0-9a-z]+)?$ ]] \
         || [[ -d "$ORIG_REAL/sessions" && -d "$ORIG_REAL/cache" ]]; then
        echo "✖ refusing to apply onto the Hermes home directory: $ORIG_REAL" >&2
        echo "  That is Hermes' own home (config + sessions), not a project. Applying would overwrite it. Discard this session and start one in a project directory." >&2
        exit 1
      fi
    fi
    for _sens in .ssh .aws .gnupg; do
      if _is_under "$ORIG_REAL" "$HOME_REAL/$_sens"; then
        echo "✖ refusing to apply onto a sensitive directory under your home: $ORIG_REAL" >&2
        echo "  Credential stores are never an apply target. Discard this session." >&2
        exit 1
      fi
    done
    for _sys in /etc /var; do
      if _is_under "$ORIG_REAL" "$_sys"; then
        echo "✖ refusing to apply onto a system directory: $ORIG_REAL" >&2
        echo "  System directories are never an apply target. Discard this session." >&2
        exit 1
      fi
    done

    # 0a) TOCTOU: the real workspace must not have changed since the clone.
    #    Without a fingerprint we cannot guarantee it -> do not apply.
    if [[ ! -f "$FP" ]]; then
      echo "✖ Session created without an integrity fingerprint; cannot guarantee the real workspace did not change." >&2
      echo "  Discard it and recreate to apply safely:" >&2
      echo "    sandboxctl discard $task_id" >&2
      exit 1
    fi
    current_fp="$(compute_fp "$ORIG")"
    if [[ "$current_fp" != "$(cat "$FP")" ]]; then
      echo "✖ The real workspace CHANGED since the copy was cloned (content, mtime or permissions). Re-sync:" >&2
      echo "    sandboxctl discard $task_id" >&2
      echo "  and let the agent create a new session. Applying now would clobber the real change." >&2
      exit 1
    fi

    # 0b) Symlink escape scan on the copy, BEFORE the sync. A symlink pointing
    #     outside the copy (created by an earlier command in the session) would
    #     be copied into the real workspace as-is and let the applied tree
    #     reach outside it. Same scan the backend's execute() runs per command.
    escaping_syms="$(python3 - "$WS" <<'PYEOF'
import os, sys
from pathlib import Path
root = Path(sys.argv[1]).resolve()
prefix = str(root).rstrip("/") + os.sep
escaping = []
for p in root.rglob("*"):
    if not p.is_symlink():
        continue
    try:
        target = os.path.realpath(p)
    except Exception:
        target = ""
    if not target or (target != str(root) and not target.startswith(prefix)):
        escaping.append(str(p))
print("\n".join(escaping[:10]))
PYEOF
)"
    if [[ -n "$escaping_syms" ]]; then
      echo "✖ Refusing to apply: the copy contains symlink(s) escaping the sandbox root:" >&2
      echo "$escaping_syms" >&2
      echo "  Nothing was applied. Remove the outward symlinks (or discard and start fresh) before applying." >&2
      exit 1
    fi

    echo "▶ Applying changes of '$task_id' to the real workspace..."
    echo "  source : $WS"
    echo "  target : $ORIG"
    echo
    # REVIEW FIRST, diff second (F1/R1). A human decides from the file list;
    # the technical diff stays available right below for the details.
    print_review "$(cat "$ORIGIN_FILE")" "$WS" "$task_id" ""
    echo
    echo "── diff técnico ──────────────────────────────────────────────"
    diff_show="$(grep -E '^[+-]|^diff |^Only |^Index |^Binary ' "$WS/PENDING.diff" 2>/dev/null || true)"
    total="$(printf '%s\n' "$diff_show" | sed '/^$/d' | wc -l | tr -d ' ')"
    printf '%s\n' "$diff_show" | head -n 60 || true
    if (( total > 60 )); then
      echo "  ... ($(( total - 60 )) more lines — run: sandboxctl diff $task_id for the full diff)"
    fi
    echo
    if [[ "$have_yes" -eq 1 ]]; then
      # --yes was verified to run on an interactive terminal at the top of the
      # script, so a human explicitly approved this apply.
      ans=s
    elif [[ -t 0 ]]; then
      read -r -p "Aprobar y escribir en el workspace real ('$ORIG')? [s/N]: " ans
    else
      # H9: even when we cannot ask, print the EXACT command that approves.
      echo "✖ apply requires interactive confirmation (best-effort guard: a determined process can allocate a pty and self-approve)." >&2
      echo "  To approve interactively, run:" >&2
      echo "    sandboxctl apply $task_id" >&2
      exit 2
    fi

    if [[ "$ans" =~ ^[sSyY]$ ]]; then
      # 1) new/modified content: rsync WITHOUT --delete and WITHOUT the pinned
      #    TMPDIR (.preflight-tmp). No file is removed from the real workspace
      #    here (a file created after the clone survives; the fingerprint above
      #    already guarantees none appeared).
      rsync -a --exclude=PENDING.diff --exclude=.preflight-tmp "$WS/" "$ORIG/"
      # 2) explicit deletions: only the paths the sandbox removed (present in
      #    ORIG, absent in WS). Never a global --delete. With a valid fingerprint
      #    no user file appeared after the clone, so the set is exact; the
      #    `! -e "$WS/$d"` guard is a second net.
      while IFS= read -r d; do
        [[ -n "$d" ]] || continue
        target="$ORIG/$d"
        # Never let a crafted deletion path escape the original workspace.
        if [[ "$target" != "$ORIG"/* ]]; then
          echo "✖ refusing deletion outside the workspace: $target" >&2
          exit 1
        fi
        if [[ ! -e "$WS/$d" ]]; then
          if [[ -d "$target" && ! -L "$target" ]]; then
            rm -rf -- "$target"
          else
            rm -f -- "$target"
          fi
        fi
      done < <(rsync -av --delete --dry-run --exclude=PENDING.diff --exclude=.preflight-tmp "$WS/" "$ORIG/" 2>/dev/null \
                | grep '^deleting ' | sed 's/^deleting //' || true)
      # 3) Post-apply lifecycle: the session is now IN SYNC with the real
      #    workspace. Empty PENDING.diff (the applied changes no longer need
      #    review) and refresh the fingerprint so reusing the same task_id
      #    legitimately starts a fresh review instead of failing with a stale
      #    "CHANGED". Re-clone happens on the next create_environment.
      : > "$WS/PENDING.diff"
      current_fp="$(compute_fp "$ORIG")"
      printf '%s\n' "$current_fp" > "$FP"
      echo "✔ Applied."
      echo "  Session '$task_id' is clean: PENDING.diff emptied, fingerprint refreshed (reuse the id for a fresh review)."
    else
      echo "✖ Apply cancelled."
      exit 1
    fi
    ;;

  discard)
    # Destructive, so the same interactive gate as apply: no TTY -> refuse.
    # (The root was already validated at startup, so PREFLIGHT_ROOT cannot aim
    # this rm at another profile's sessions.) Deliberately does NOT read the
    # registration record: whatever $ORIG says, this rm stays inside ROOT, and
    # discard must remain the way out of a session whose record was tampered
    # with (it never applies anything).
    if [[ "$have_yes" -eq 1 ]]; then
      ans=s
    elif [[ -t 0 ]]; then
      read -r -p "Discard session '$task_id'? this removes the COPY, the real workspace is not touched [y/N]: " ans
    else
      echo "✖ discard requires interactive confirmation (best-effort guard: a determined process can allocate a pty and self-approve)." >&2
      exit 2
    fi
    if [[ ! "$ans" =~ ^[sSyY]$ ]]; then
      echo "✖ Discard cancelled."
      exit 1
    fi
    rm -rf -- "$ROOT/$task_id"
    echo "✔ Session '$task_id' discarded (the real workspace was not touched)."
    ;;

  *)
    echo "unknown command: $cmd (status|diff|apply|discard)"
    exit 2
    ;;
esac
